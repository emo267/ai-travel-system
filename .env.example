# 复制为 .env 并填入真实 Key：cp .env.example .env
#deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=
# 双模型：chat 负责结构化输出（行程生成/价格抽取），flash 负责对话与工具调研
# flash 是思考模式，不支持强制 tool_choice，不能拿去做结构化输出
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_THINKING=deepseek-flash

#tavily 联网搜索（https://app.tavily.com 获取）
TAVILY_API_KEY=

#和风天气（控制台 → 项目管理 → 我的项目 里显示的 API Host）
QWEATHER_API_HOST=
QWEATHER_API_KEY=

#高德地图 Web 服务（REST）Key
AMAP_API_KEY=
