# ── 数据库 / 缓存（本地 localhost）──
DATABASE_URL=mysql+pymysql://root:your-db-password@localhost:3306/travel_planner?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# ── 认证 ──
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=http://localhost:5173

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_THINKING=deepseek-flash

#tavily 联网搜索
TAVILY_API_KEY=tvly-your-tavily-api-key

#和风天气
QWEATHER_API_HOST=your-id.re.qweatherapi.com
QWEATHER_API_KEY=your-qweather-api-key

#高德地图 Web 服务
AMAP_API_KEY=your-amap-web-service-key
